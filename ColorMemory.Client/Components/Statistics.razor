@using ColorMemory.Shared.Models

@if (Visible)
{
    <div>
        <h2>Statistics</h2>
        <h3>Player: @Player.Name</h3>
        <p>Ranking: @Player.Rank</p>
        <p>Total time: @Player.Time sek</p>
    </div>
}

@code {
    [Parameter]
    public required Player Player { get; set; }

    [Parameter]
    public bool Visible { get; set; }
}