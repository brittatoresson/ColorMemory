
@if (!GameService.IsGameActive)
{
    <button class="btn btn-primary" @onclick="StartGame">Start memory</button>
}
else
{
    <h3>Total points: @GameService.Points</h3>

    <div class="memory-grid">
        @foreach (var card in GameService.Cards)
        {
            <MemoryCard Card="card" FlipCard="FlipCard" Disable="@_disableClick" />
        }
    </div>

    @if (GameService.MatchedCards.Count > 0)
    {
        <div class="d-flex align-items-center justify-content-center">
            @foreach (var card in GameService.MatchedCards)
            {
                <MemoryCardMatch Card="card" />
            }
        </div>
    }
}
<Statistics Player="@_player" Visible="@_displayStatistics" />

